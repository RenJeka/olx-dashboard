{
  "name": "olx-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Персональна система моніторингу оголошень OLX.ua",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w server run build && npm -w web run build",
    "scan": "npm -w server run scan --",
    "jev:pilot": "npm -w server run jev:pilot --",
    "jev:probe": "npm -w server run jev:probe --",
    "migrate:posted-at": "npm -w server run migrate:posted-at",
    "docs:check": "node scripts/check-doc-links.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "npm -w server exec -- tsc -p tsconfig.json --noEmit && npm -w web exec -- tsc -b --noEmit",
    "check": "npm run typecheck && npm run test && npm run docs:check && npm run skills:check",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "test": "npm -w server run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
